{
  "manifest_version": 3,
  "name": "Local PDF Sentence Navigator",
  "version": "1.1.0",
  "description": "Navigate PDF sentences locally in Chrome with keyboard-first sentence navigation.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content-main.js", "modules/*.js"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "action": {
    "default_title": "PDF sentence navigator",
    "default_popup": "popup.html"
  }
}
